# Client
VITE_PUBLIC_BUILDER_KEY=your_builder_public_key

# Application URLs
APP_PUBLIC_URL=http://127.0.0.1:8080
PING_MESSAGE=ping

# Auth & API
JWT_SECRET=replace-with-secure-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=public-anon-key

# PayFast integration
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_PASSPHRASE=your_optional_passphrase
PAYFAST_MODE=sandbox
PAYFAST_IP_WHITELIST=127.0.0.1
PAYFAST_NOTIFY_URL=http://127.0.0.1:8080/api/payfast/ipn
